# Bu faylni .env deb nusxalang va o'z qiymatlaringizni kiriting:
# cp .env.example .env

PORT=3000

# @BotFather orqali yaratilgan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:AA...sizning-tokeningiz

# Buyurtmalar keladigan Telegram chat/kanal ID (o'zingizga yoki guruhga)
# ID olish uchun @userinfobot yoki @getidsbot ga yozing
TELEGRAM_CHAT_ID=123456789

# Admin panelga kirish uchun uzun, tasodifiy maxfiy kalit (hech kimga bermang)
ADMIN_TOKEN=ADMIN_TOKEN=020b8a357f9ae0c95d4c692cb56d20b8308958a6f6cb9767998a77a137dd7e79

# Faqat shu domendan kelgan so'rovlarga ruxsat berish (bir nechta bo'lsa vergul bilan ajrating)
ALLOWED_ORIGIN=https://sizning-domeningiz.com
